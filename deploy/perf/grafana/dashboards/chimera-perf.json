{
  "uid": "chimera-perf",
  "title": "Chimera perf",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latency p95 by step",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "perfprom"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (step, le) (rate(k6_http_req_duration_seconds_bucket{phase=\"measure\"}[30s])))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "perfprom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{phase=\"measure\"}[30s]))",
          "legendFormat": "rps"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Unexpected failures per second",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "perfprom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_unexpected_fail_total[30s]))",
          "legendFormat": "unexpected"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU cores",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "perfprom"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"chimera\",container=~\"gateway|identity|catalog|social|postgres|kafka|rustfs|edge\"}[30s]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RAM",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "perfprom"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"chimera\",container=~\"gateway|identity|catalog|social|postgres|kafka|rustfs|edge\"})",
          "legendFormat": "{{container}}"
        }
      ]
    }
  ]
}
