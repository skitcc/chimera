# Copy to secrets.env (gitignored) and replace every value, or run make k8s-secrets.
# Database passwords go into connection URLs: use only A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD=replace-me-admin
# The replicas clone the primary and stream WAL as this role.
POSTGRES_REPLICATION_PASSWORD=replace-me-replication
IDENTITY_DB_PASSWORD=replace-me-identity
CATALOG_DB_PASSWORD=replace-me-catalog
SOCIAL_DB_PASSWORD=replace-me-social
# <svc>_ro roles: SELECT only, used for reads from the replicas.
IDENTITY_DB_READ_PASSWORD=replace-me-identity-ro
CATALOG_DB_READ_PASSWORD=replace-me-catalog-ro
SOCIAL_DB_READ_PASSWORD=replace-me-social-ro
# RustFS root credentials; Catalog signs URLs with the same pair.
S3_ACCESS_KEY=chimera
S3_SECRET_KEY=replace-me-objects
# Grafana admin at /monitoring and basic auth for adminer at /admin.
GRAFANA_ADMIN_PASSWORD=replace-me-grafana
ADMIN_PASSWORD=replace-me-admin-ui

# AUTH_CODE_HMAC_KEY is generated by make k8s-secrets, or set a random value of at least 32 bytes.
