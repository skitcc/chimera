# Copy to secrets.env (gitignored) and replace every value.
# Database passwords go into connection URLs: use only A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD=replace-me-admin
IDENTITY_DB_PASSWORD=replace-me-identity
CATALOG_DB_PASSWORD=replace-me-catalog
SOCIAL_DB_PASSWORD=replace-me-social
# RustFS root credentials; Catalog signs URLs with the same pair.
S3_ACCESS_KEY=chimera
S3_SECRET_KEY=replace-me-objects
