      "targets": [
        {
          "expr": "sum by (job) (rate(process_cpu_seconds_total{job=~\"${service:regex}\",pod=~\"${pod:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ]
    },
