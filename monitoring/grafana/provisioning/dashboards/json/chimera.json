        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "((sum by (job,pod) (rate(chimera_http_requests_total{job=~\"${service:regex}\",pod=~\"${pod:regex}\",path!~\"/(live|ready|metrics)\"}[$__rate_interval])) or sum by (job,pod) (rate(rpc_server_call_duration_seconds_count{job=~\"${service:regex}\",pod=~\"${pod:regex}\",rpc_method!~\"/?grpc.health.v1.Health/.*\"}[$__rate_interval]))) or on(job,pod) (0 * max by (job,pod) (process_start_time_seconds{job=~\"${service:regex}\",pod=~\"${pod:regex}\"})))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Задержка p95 / p99 — $service",
      "description": "Квантили считаются по histogram buckets отдельно для каждого pod. Gateway: HTTP, остальные: gRPC. При отсутствии запросов квантиль не определён, линия не рисуется.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, (sum by (job,pod,le) (rate(chimera_http_request_duration_seconds_bucket{job=~\"${service:regex}\",pod=~\"${pod:regex}\",path!~\"/(live|ready|metrics)\"}[$__rate_interval])) or sum by (job,pod,le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"${service:regex}\",pod=~\"${pod:regex}\",rpc_method!~\"/?grpc.health.v1.Health/.*\"}[$__rate_interval]))))",
          "legendFormat": "{{pod}} p95",
          "refId": "A",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.99, (sum by (job,pod,le) (rate(chimera_http_request_duration_seconds_bucket{job=~\"${service:regex}\",pod=~\"${pod:regex}\",path!~\"/(live|ready|metrics)\"}[$__rate_interval])) or sum by (job,pod,le) (rate(rpc_server_call_duration_seconds_bucket{job=~\"${service:regex}\",pod=~\"${pod:regex}\",rpc_method!~\"/?grpc.health.v1.Health/.*\"}[$__rate_interval]))))",
          "legendFormat": "{{pod}} p99",
          "refId": "B",
          "range": true
        }
      ]
    },
