{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Доступные /metrics по сервисам — ожидается 3",
      "description": "Число успешно опрашиваемых Prometheus целей. В текущем стенде по 3 pod на сервис. Это доступность scrape, а не Kubernetes readiness. Имена pod ниже приходят из метрик приложения.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum by (job) (up{job=~\"${service:regex}\"})",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RPS по сервисам",
      "description": "Gateway: входящий HTTP без /live, /ready, /metrics. Остальные сервисы: входящий gRPC без healthcheck. Не складывайте эти линии в пользовательский RPS: один HTTP-запрос может вызвать несколько RPC.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (job) (((sum by (job,pod) (rate(chimera_http_requests_total{job=~\"${service:regex}\",pod=~\"${pod:regex}\",path!~\"/(live|ready|metrics)\"}[$__rate_interval])) or sum by (job,pod) (rate(rpc_server_call_duration_seconds_count{job=~\"${service:regex}\",pod=~\"${pod:regex}\",rpc_method!~\"/?grpc.health.v1.Health/.*\"}[$__rate_interval]))) or on(job,pod) (0 * max by (job,pod) (process_start_time_seconds{job=~\"${service:regex}\",pod=~\"${pod:regex}\"}))))",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ошибки: HTTP 5xx / gRPC non-OK",
      "description": "HTTP: только серверные 5xx. gRPC: все non-OK, включая ошибки входных данных и авторизации; это не эквивалент HTTP 5xx. При отсутствии трафика показывается 0%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (job) (((sum by (job,pod) (rate(chimera_http_requests_total{job=~\"${service:regex}\",pod=~\"${pod:regex}\",path!~\"/(live|ready|metrics)\",status=~\"5..\"}[$__rate_interval])) or sum by (job,pod) (rate(rpc_server_call_duration_seconds_count{job=~\"${service:regex}\",pod=~\"${pod:regex}\",rpc_method!~\"/?grpc.health.v1.Health/.*\",rpc_response_status_code!~\"OK|0\"}[$__rate_interval]))) or on(job,pod) (0 * max by (job,pod) (process_start_time_seconds{job=~\"${service:regex}\",pod=~\"${pod:regex}\"})))) / clamp_min(sum by (job) (((sum by (job,pod) (rate(chimera_http_requests_total{job=~\"${service:regex}\",pod=~\"${pod:regex}\",path!~\"/(live|ready|metrics)\"}[$__rate_interval])) or sum by (job,pod) (rate(rpc_server_call_duration_seconds_count{job=~\"${service:regex}\",pod=~\"${pod:regex}\",rpc_method!~\"/?grpc.health.v1.Health/.*\"}[$__rate_interval]))) or on(job,pod) (0 * max by (job,pod) (process_start_time_seconds{job=~\"${service:regex}\",pod=~\"${pod:regex}\"})))), 1e-9)",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU по сервисам",
      "description": "Сумма CPU процессов выбранных pod. 1 core означает одно полностью занятое ядро; это не процент от лимита контейнера.",
