APP_MODE=development
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=3s
HTTP_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=debug

PROJECT_NAME=chimera
API_PORT=8080
FRONTEND_PORT=5173

POSTGRES_USER=chimera
POSTGRES_PASSWORD=chimera
POSTGRES_DB=chimera
POSTGRES_PORT=5432
DATABASE_URL=postgres://chimera:chimera@127.0.0.1:5432/chimera?sslmode=disable
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONNS=10
POSTGRES_MAX_CONN_IDLE=5m
POSTGRES_MAX_CONN_LIFETIME=30m

JWT_SECRET=replace-me
JWT_TTL=24h

WORKER_POOL_SIZE=4
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=3s

MINIO_ROOT_USER=chimera
MINIO_ROOT_PASSWORD=chimera123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=*

S3_ENDPOINT=http://127.0.0.1:9000
S3_PRESIGN_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=chimera
S3_SECRET_KEY=chimera123
S3_BUCKET=music-raw
S3_REGION=us-east-1
S3_PRESIGN_TTL=15m
TRACK_MAX_BYTES=104857600
