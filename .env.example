# Template for local development. Copy to .env; every value here is a placeholder.

APP_MODE=development
LOG_LEVEL=debug
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=3s

PROJECT_NAME=chimera
API_PORT=8080
FRONTEND_PORT=5173
OPENAPI_MOCK_PORT=4010

# Gateway (REST edge). The services behind it speak gRPC on :9090 inside the network.
HTTP_SHUTDOWN_TIMEOUT=3s
HTTP_READ_HEADER_TIMEOUT=5s
# Must outlast GRPC_RETRY_MAX_ATTEMPTS calls of GRPC_CLIENT_TIMEOUT each.
HTTP_WRITE_TIMEOUT=15s
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m
# CIDRs or IPs of reverse proxies whose X-Forwarded-For the rate limiter trusts.
# Empty: the limiter keys on the TCP peer address.
TRUSTED_PROXIES=
# The only host a stream redirect may point to; must match S3_PRESIGN_ENDPOINT.
STREAM_HOST=127.0.0.1:9000

# gRPC services (Identity, Catalog, Social).
SHUTDOWN_TIMEOUT=10s
# gRPC servers close older client connections, so clients re-resolve and reach new instances.
GRPC_MAX_CONNECTION_AGE=30s
# Per attempt. A client repeats UNAVAILABLE, and DEADLINE_EXCEEDED of calls safe to
# repeat, up to GRPC_RETRY_MAX_ATTEMPTS attempts with jittered exponential backoff.
GRPC_CLIENT_TIMEOUT=3s
GRPC_RETRY_MAX_ATTEMPTS=3
GRPC_RETRY_BACKOFF=50ms

# Identity signs Ed25519 JWTs; Gateway only verifies them. docker compose generates the
# key pair into volumes on first start (deploy/keygen), so no key file lives in git.
JWT_TTL=24h

# One Postgres, one database and role per service (deploy/postgres/init-databases.sh).
POSTGRES_USER=chimera
POSTGRES_PASSWORD=replace-me-admin
POSTGRES_PORT=5432
IDENTITY_DB_PASSWORD=replace-me-identity
CATALOG_DB_PASSWORD=replace-me-catalog
SOCIAL_DB_PASSWORD=replace-me-social
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONNS=10
POSTGRES_MAX_CONN_IDLE=5m
POSTGRES_MAX_CONN_LIFETIME=30m
# Postgres cancels a statement that runs longer.
POSTGRES_STATEMENT_TIMEOUT=5s

# Kafka (KRaft, single node). Services reach kafka:9092; the host listener is for tools.
KAFKA_PORT=9094
KAFKA_TOPIC_PARTITIONS=3
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=100
KAFKA_PRODUCE_TIMEOUT=10s
# A consumer retries a failing record this many times, then moves it to <topic>.dlq.
KAFKA_RETRY_MAX_ATTEMPTS=8
KAFKA_RETRY_BACKOFF=200ms
KAFKA_RETRY_MAX_BACKOFF=30s

# Always-on test stand (docker-compose.test.yml, project chimera-stand).
# make stand-up leaves Postgres and RustFS running. Each integration run creates
# one empty database per service, migrates it, and drops it afterwards.
# The tester URL points at the maintenance database.
POSTGRES_TEST_IMAGE=postgres:17-alpine
POSTGRES_TEST_USER=chimera_test
POSTGRES_TEST_PASSWORD=replace-test-only
POSTGRES_TEST_PORT=54329
STAND_MINIO_PORT=9002
POSTGRES_TEST_HEALTH_INTERVAL=2s
POSTGRES_TEST_HEALTH_TIMEOUT=5s
POSTGRES_TEST_HEALTH_RETRIES=30
# TEST_DATABASE_URL=postgres://chimera_test:replace-test-only@127.0.0.1:54329/postgres?sslmode=disable

# AIStor refuses S3 calls without a license. RustFS speaks the same S3 API Catalog uses.
MINIO_IMAGE=rustfs/rustfs:latest@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
MINIO_ROOT_USER=chimera
MINIO_ROOT_PASSWORD=replace-me-objects
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=*

# Catalog. S3_PRESIGN_ENDPOINT is the address browsers upload to and stream from.
S3_PRESIGN_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=chimera
S3_SECRET_KEY=replace-me-objects
S3_BUCKET=music-raw
S3_REGION=us-east-1
S3_PRESIGN_TTL=15m
S3_TIMEOUT=5s
TRACK_MAX_BYTES=104857600

# Required shared secret for OTP HMAC. Generate with: openssl rand -hex 32
AUTH_CODE_HMAC_KEY=
# Mailpit for local development; set TLS and credentials for a real SMTP server.
SMTP_ADDR=mailpit:1025
SMTP_FROM=no-reply@chimera.local
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
