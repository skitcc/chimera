APP_MODE=development
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=3s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=debug

PROJECT_NAME=chimera
API_PORT=8080
FRONTEND_PORT=5173
OPENAPI_MOCK_PORT=4010

POSTGRES_USER=chimera
POSTGRES_PASSWORD=chimera
POSTGRES_DB=chimera
POSTGRES_PORT=5432
DATABASE_URL=postgres://chimera:chimera@127.0.0.1:5432/chimera?sslmode=disable
# The primary API creates this role and keeps it on SELECT only.
# Read API processes set DATABASE_READ_ONLY=true and connect to the physical replica.
POSTGRES_READONLY_USER=chimera_ro
POSTGRES_READONLY_PASSWORD=chimera-ro
POSTGRES_REPLICATION_USER=chimera_repl
POSTGRES_REPLICATION_PASSWORD=repl-secret
POSTGRES_REPLICA_PORT=5433
API_READ_PORT_1=8081
API_READ_PORT_2=8082
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONNS=10
POSTGRES_MAX_CONN_IDLE=5m
POSTGRES_MAX_CONN_LIFETIME=30m

# Always-on test stand (docker-compose.test.yml, project chimera-stand).
# make stand-up leaves Postgres and RustFS running. Each integration run and
# each e2e run clones chimera_template once and does not stop the stand.
# The tester URL points at the maintenance database.
POSTGRES_TEST_IMAGE=postgres:17-alpine
POSTGRES_TEST_USER=chimera_test
POSTGRES_TEST_PASSWORD=replace-test-only
POSTGRES_TEST_PORT=54329
STAND_MINIO_PORT=9002
POSTGRES_TEST_HEALTH_INTERVAL=2s
POSTGRES_TEST_HEALTH_TIMEOUT=5s
POSTGRES_TEST_HEALTH_RETRIES=30
# TEST_DATABASE_URL=postgres://chimera_test:replace-test-only@127.0.0.1:54329/postgres?sslmode=disable

JWT_SECRET=replace-me
JWT_TTL=24h
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m

WORKER_POOL_SIZE=4
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=3s

# AIStor refuses S3 calls without a license. RustFS speaks the same S3 API the backend uses.
MINIO_IMAGE=rustfs/rustfs:latest@sha256:8cc9801755448b71a786705ce76692c77e14936cccd87cf2fc31842e58f4d1ff
MINIO_ROOT_USER=chimera
MINIO_ROOT_PASSWORD=chimera123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=*

S3_ENDPOINT=http://127.0.0.1:9000
S3_PRESIGN_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=chimera
S3_SECRET_KEY=chimera123
S3_BUCKET=music-raw
S3_REGION=us-east-1
S3_PRESIGN_TTL=15m
TRACK_MAX_BYTES=104857600

# Leave empty to keep /admin closed. No host port is published for the database UI.
ADMIN_USER=
ADMIN_PASSWORD=

GRAFANA_ADMIN_USER=chimera
GRAFANA_ADMIN_PASSWORD=chimera-grafana
